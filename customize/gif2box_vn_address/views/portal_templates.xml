<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The portal's "Your details" form (/my/account), given the address
        /shop/address asks for:

            1. Country           (searchable)
            2. Province / City   (today's 34, searchable, found by the
                                  names they absorbed in 2025 too)
            3. Ward / Commune    (the wards of that province, searchable)
            4. Detailed address

        Odoo's form there has no ward, lists the 63 provinces of before the
        2025 merger, and asks for a free-text "City", a second address line
        and a postcode, which for Vietnam the ward replaces: they are hidden
        for Vietnam and shown again for another country. The address saved
        here is the one checkout starts from, and the shipping fee is worked
        out from its ward.

        Saving and checking: `controllers/main.py` (CustomerPortalVnAddress);
        the ward list follows the province: `static/src/js/portal_address_vn.js`.

        The `position="move"` xpaths are direct children of their spec on
        purpose: that is the only place Odoo honours them.
    -->
    <template id="portal_details_vn" inherit_id="portal.portal_my_details_fields"
              name="Vietnamese address in the portal details">

        <xpath expr="//div[input[@name='street']]" position="before">
            <t t-set="g2b_vn" t-value="request.env.ref('base.vn')"/>
            <t t-set="g2b_country_id"
               t-value="(int(country_id) if str(country_id).isdigit() else False) if country_id else partner.country_id.id"/>
            <t t-set="g2b_is_vn" t-value="g2b_country_id == g2b_vn.id"/>
            <xpath expr="//div[select[@name='country_id']]" position="move"/>
            <xpath expr="//div[select[@name='state_id']]" position="move"/>
            <t t-set="g2b_wards" t-value="request.env['res.country.ward']._vn_portal_wards(state_id, partner)"/>
            <t t-set="g2b_ward_id"
               t-value="int(ward_id) if str(ward_id or '').isdigit() else partner.ward_id.id"/>
            <div id="div_ward"
                 t-attf-class="mb-3 #{error.get('ward_id') and 'o_has_error' or ''} col-xl-6"
                 t-att-style="not g2b_is_vn and 'display: none'">
                <label class="col-form-label" for="o_portal_ward_id">Ward / Commune</label>
                <select id="o_portal_ward_id" name="ward_id"
                        t-attf-class="form-select #{error.get('ward_id') and 'is-invalid' or ''}"
                        data-g2b-searchable="1"
                        t-att-data-g2b-vn-country="g2b_vn.id"
                        placeholder="Search a ward or commune..."
                        t-att-disabled="not g2b_wards and 'disabled'">
                    <option t-if="g2b_wards" value="">Select a ward / commune...</option>
                    <option t-else="" value="">Select a province / city first</option>
                    <t t-foreach="g2b_wards" t-as="g2b_ward">
                        <option t-att-value="g2b_ward.id" t-att-selected="g2b_ward.id == g2b_ward_id">
                            <t t-out="g2b_ward.name"/>
                        </option>
                    </t>
                </select>
                <!-- The prompts the script swaps in when it rebuilds the list;
                     block elements, so each is one term to translate. -->
                <div class="d-none" data-g2b-prompt="pick-ward">Select a ward / commune...</div>
                <div class="d-none" data-g2b-prompt="pick-state">Select a province / city first</div>
            </div>
        </xpath>

        <!-- Country -->
        <xpath expr="//select[@name='country_id']" position="attributes">
            <attribute name="id">o_portal_country_id</attribute>
            <attribute name="data-g2b-searchable">1</attribute>
            <attribute name="placeholder">Search a country...</attribute>
        </xpath>
        <xpath expr="//select[@name='country_id']/t[@t-as='country']/option" position="attributes">
            <attribute name="t-att-data-g2b-keywords">country._g2b_search_keywords()</attribute>
        </xpath>
        <xpath expr="//label[@for='country_id']" position="attributes">
            <attribute name="for">o_portal_country_id</attribute>
        </xpath>

        <!-- Province: today's, in reading order, with what they absorbed -->
        <xpath expr="//select[@name='state_id']" position="attributes">
            <attribute name="id">o_portal_state_id</attribute>
            <attribute name="data-g2b-searchable">1</attribute>
            <attribute name="placeholder">Search a province or city...</attribute>
        </xpath>
        <xpath expr="//label[@for='state_id']" position="attributes">
            <attribute name="for">o_portal_state_id</attribute>
        </xpath>
        <xpath expr="//select[@name='state_id']/t[@t-as='state']" position="attributes">
            <attribute name="t-foreach">request.env['res.country.state']._vn_portal_states(states, partner.state_id)</attribute>
        </xpath>
        <xpath expr="//select[@name='state_id']/t[@t-as='state']/option" position="attributes">
            <attribute name="t-att-data-g2b-hint">state._vn_search_hint() or None</attribute>
            <attribute name="t-att-data-g2b-keywords">state._vn_search_keywords() or None</attribute>
            <!-- A province merged away, still on the contact: listed last. -->
            <attribute name="t-att-data-g2b-obsolete">state.country_id.code == 'VN' and not state.vn_gso_code and '1' or None</attribute>
        </xpath>

        <!-- Street: the one line under the ward, for Vietnam -->
        <xpath expr="//label[@for='street']" position="replace">
            <label class="col-form-label" for="street">
                <t t-if="g2b_is_vn">Detailed address</t>
                <t t-else="">Street</t>
            </label>
        </xpath>
        <xpath expr="//input[@name='street']" position="attributes">
            <attribute name="placeholder">House number, street, building, apartment...</attribute>
        </xpath>

        <!-- What the ward replaces, for Vietnam -->
        <xpath expr="//div[input[@name='city']]" position="attributes">
            <attribute name="t-att-style">g2b_is_vn and 'display: none'</attribute>
        </xpath>
        <xpath expr="//div[input[@name='street2']]" position="attributes">
            <attribute name="t-att-style">g2b_is_vn and 'display: none'</attribute>
        </xpath>
        <xpath expr="//div[input[@name='zipcode']]" position="attributes">
            <attribute name="t-att-style">g2b_is_vn and 'display: none'</attribute>
        </xpath>
    </template>

</odoo>
