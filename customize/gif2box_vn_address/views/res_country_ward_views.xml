<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_country_ward_view_list" model="ir.ui.view">
        <field name="name">res.country.ward.list</field>
        <field name="model">res.country.ward</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="division_type"/>
                <field name="state_id"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="res_country_ward_view_form" model="ir.ui.view">
        <field name="name">res.country.ward.form</field>
        <field name="model">res.country.ward</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="division_type"/>
                        <field name="state_id" options="{'no_create': True}"/>
                        <field name="country_id"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_country_ward_view_search" model="ir.ui.view">
        <field name="name">res.country.ward.search</field>
        <field name="model">res.country.ward</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="state_id"/>
                <filter name="filter_phuong" string="Wards" domain="[('division_type', '=', 'phuong')]"/>
                <filter name="filter_xa" string="Communes" domain="[('division_type', '=', 'xa')]"/>
                <filter name="filter_dac_khu" string="Special zones" domain="[('division_type', '=', 'dac_khu')]"/>
                <group>
                    <filter name="group_state" string="Province / City" context="{'group_by': 'state_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'division_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="res_country_ward_action" model="ir.actions.act_window">
        <field name="name">Wards / Communes</field>
        <field name="res_model">res.country.ward</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <menuitem id="res_country_ward_menu"
              name="Wards / Communes"
              parent="contacts.menu_localisation"
              action="res_country_ward_action"
              sequence="3"/>

    <!--
        The ward on the customer form, after the province it belongs to, and
        only for Vietnamese addresses. Read-only on the same terms as the rest
        of the address: a contact that inherits its company's address cannot
        edit it here.
    -->
    <record id="view_partner_form_ward" model="ir.ui.view">
        <field name="name">res.partner.form.ward</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state_id'][hasclass('o_address_state')]" position="after">
                <field name="ward_id" class="o_address_street" placeholder="Ward / Commune"
                       options="{'no_open': True, 'no_create': True}"
                       invisible="country_code != 'VN'"
                       readonly="type == 'contact' and parent_id"/>
            </xpath>
        </field>
    </record>

</odoo>
