<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Mark as delivered" from the lists, for a courier's daily report of
         several parcels at once. -->
    <record id="action_sale_order_mark_delivered" model="ir.actions.server">
        <field name="name">Mark as delivered</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_g2b_mark_delivered()</field>
    </record>

    <record id="action_stock_picking_mark_delivered" model="ir.actions.server">
        <field name="name">Mark as delivered</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_g2b_mark_delivered()</field>
    </record>

</odoo>
