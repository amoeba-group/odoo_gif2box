#. module: gif2box_order_tracking
#: model:mail.template,body_html:gif2box_order_tracking.mail_template_order_delivered
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px; line-height: 1.6; color: #212529;\">\n"
"    <p style=\"margin: 0 0 12px;\">Hello <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 4px; font-size: 18px; font-weight: 700; color: #1F8A5B;\">Your gift has been delivered.</p>\n"
"    <p style=\"margin: 0 0 20px;\">The recipient has received your order.</p>\n"
"    <table cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; max-width: 480px; margin: 0 0 24px; border-collapse: collapse; font-size: 14px;\">\n"
"        <tr>\n"
"            <td style=\"padding: 6px 0; color: #6c757d; width: 45%;\">Order</td>\n"
"            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"object.name\"/>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px 0; color: #6c757d;\">Recipient</td>\n"
"            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"object.partner_shipping_id.name or ''\"/>\n"
"        </tr>\n"
"        <tr t-if=\"object.g2b_delivered_at\">\n"
"            <td style=\"padding: 6px 0; color: #6c757d;\">Delivered on</td>\n"
"            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"format_datetime(object.g2b_delivered_at, tz=object._g2b_tz(), dt_format='HH:mm, dd/MM/yyyy')\"/>\n"
"        </tr>\n"
"    </table>\n"
"    <p style=\"margin: 0 0 28px;\">\n"
"        <a t-att-href=\"object._g2b_tracking_url(absolute=True)\" style=\"display: inline-block; padding: 12px 28px; font-weight: 600; color: #ffffff; text-decoration: none; background-color: #FD7352; border-radius: 24px;\">See your order</a>\n"
"    </p>\n"
"    <p style=\"margin: 0; color: #6c757d; font-size: 13px;\">Thank you for choosing Gif2box.</p>\n"
"</div>\n"
"            "
msgstr "<div style=\"margin: 0; padding: 0; font-size: 14px; line-height: 1.6; color: #212529;\">\n    <p style=\"margin: 0 0 12px;\"><t t-out=\"object.partner_id.name or ''\"/> 님, 안녕하세요.</p>\n    <p style=\"margin: 0 0 4px; font-size: 18px; font-weight: 700; color: #1F8A5B;\">선물이 배송 완료되었습니다.</p>\n    <p style=\"margin: 0 0 20px;\">받는 분이 선물을 수령했습니다.</p>\n    <table cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; max-width: 480px; margin: 0 0 24px; border-collapse: collapse; font-size: 14px;\">\n        <tr>\n            <td style=\"padding: 6px 0; color: #6c757d; width: 45%;\">주문 번호</td>\n            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"object.name\"/>\n        </tr>\n        <tr>\n            <td style=\"padding: 6px 0; color: #6c757d;\">받는 분</td>\n            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"object.partner_shipping_id.name or ''\"/>\n        </tr>\n        <tr t-if=\"object.g2b_delivered_at\">\n            <td style=\"padding: 6px 0; color: #6c757d;\">배송 완료 시각</td>\n            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"format_datetime(object.g2b_delivered_at, tz=object._g2b_tz(), dt_format='HH:mm, dd/MM/yyyy')\"/>\n        </tr>\n    </table>\n    <p style=\"margin: 0 0 28px;\">\n        <a t-att-href=\"object._g2b_tracking_url(absolute=True)\" style=\"display: inline-block; padding: 12px 28px; font-weight: 600; color: #ffffff; text-decoration: none; background-color: #FD7352; border-radius: 24px;\">주문 보기</a>\n    </p>\n    <p style=\"margin: 0; color: #6c757d; font-size: 13px;\">Gif2box를 이용해 주셔서 감사합니다.</p>\n</div>\n            "

#. module: gif2box_order_tracking
#: model:mail.template,body_html:gif2box_order_tracking.mail_template_order_shipped
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px; line-height: 1.6; color: #212529;\">\n"
"    <t t-set=\"ship\" t-value=\"object._g2b_shipment()\"/>\n"
"    <t t-set=\"eta\" t-value=\"object._g2b_eta()\"/>\n"
"    <p style=\"margin: 0 0 12px;\">Hello <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 4px; font-size: 18px; font-weight: 700; color: #004444;\">Your gift is on its way.</p>\n"
"    <p style=\"margin: 0 0 20px;\">We have handed it to the courier, who is taking it to the recipient.</p>\n"
"    <table cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; max-width: 480px; margin: 0 0 24px; border-collapse: collapse; font-size: 14px;\">\n"
"        <tr>\n"
"            <td style=\"padding: 6px 0; color: #6c757d; width: 45%;\">Order</td>\n"
"            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"object.name\"/>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px 0; color: #6c757d;\">Recipient</td>\n"
"            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"object.partner_shipping_id.name or ''\"/>\n"
"        </tr>\n"
"        <tr t-if=\"ship['carrier']\">\n"
"            <td style=\"padding: 6px 0; color: #6c757d;\">Courier</td>\n"
"            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"ship['carrier']\"/>\n"
"        </tr>\n"
"        <tr t-if=\"ship['reference']\">\n"
"            <td style=\"padding: 6px 0; color: #6c757d;\">Tracking number</td>\n"
"            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"ship['reference']\"/>\n"
"        </tr>\n"
"        <tr t-if=\"eta and eta['from']\">\n"
"            <td style=\"padding: 6px 0; color: #6c757d;\">Expected delivery</td>\n"
"            <td style=\"padding: 6px 0; font-weight: 600;\">\n"
"                <t t-out=\"format_date(eta['from'], date_format='EEE dd/MM')\"/><t t-if=\"eta['to'] != eta['from']\"> – <t t-out=\"format_date(eta['to'], date_format='EEE dd/MM')\"/></t>\n"
"            </td>\n"
"        </tr>\n"
"    </table>\n"
"    <p style=\"margin: 0 0 28px;\">\n"
"        <a t-att-href=\"object._g2b_tracking_url(absolute=True)\" style=\"display: inline-block; padding: 12px 28px; font-weight: 600; color: #ffffff; text-decoration: none; background-color: #FD7352; border-radius: 24px;\">Track your order</a>\n"
"    </p>\n"
"    <p style=\"margin: 0; color: #6c757d; font-size: 13px;\">You will get another email once the gift has been delivered.</p>\n"
"</div>\n"
"            "
msgstr "<div style=\"margin: 0; padding: 0; font-size: 14px; line-height: 1.6; color: #212529;\">\n    <t t-set=\"ship\" t-value=\"object._g2b_shipment()\"/>\n    <t t-set=\"eta\" t-value=\"object._g2b_eta()\"/>\n    <p style=\"margin: 0 0 12px;\"><t t-out=\"object.partner_id.name or ''\"/> 님, 안녕하세요.</p>\n    <p style=\"margin: 0 0 4px; font-size: 18px; font-weight: 700; color: #004444;\">선물이 배송을 시작했습니다.</p>\n    <p style=\"margin: 0 0 20px;\">택배사에 인계했으며 받는 분께 배송 중입니다.</p>\n    <table cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; max-width: 480px; margin: 0 0 24px; border-collapse: collapse; font-size: 14px;\">\n        <tr>\n            <td style=\"padding: 6px 0; color: #6c757d; width: 45%;\">주문 번호</td>\n            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"object.name\"/>\n        </tr>\n        <tr>\n            <td style=\"padding: 6px 0; color: #6c757d;\">받는 분</td>\n            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"object.partner_shipping_id.name or ''\"/>\n        </tr>\n        <tr t-if=\"ship['carrier']\">\n            <td style=\"padding: 6px 0; color: #6c757d;\">택배사</td>\n            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"ship['carrier']\"/>\n        </tr>\n        <tr t-if=\"ship['reference']\">\n            <td style=\"padding: 6px 0; color: #6c757d;\">운송장 번호</td>\n            <td style=\"padding: 6px 0; font-weight: 600;\" t-out=\"ship['reference']\"/>\n        </tr>\n        <tr t-if=\"eta and eta['from']\">\n            <td style=\"padding: 6px 0; color: #6c757d;\">도착 예정</td>\n            <td style=\"padding: 6px 0; font-weight: 600;\">\n                <t t-out=\"format_date(eta['from'], date_format='EEE dd/MM')\"/><t t-if=\"eta['to'] != eta['from']\"> – <t t-out=\"format_date(eta['to'], date_format='EEE dd/MM')\"/></t>\n            </td>\n        </tr>\n    </table>\n    <p style=\"margin: 0 0 28px;\">\n        <a t-att-href=\"object._g2b_tracking_url(absolute=True)\" style=\"display: inline-block; padding: 12px 28px; font-weight: 600; color: #ffffff; text-decoration: none; background-color: #FD7352; border-radius: 24px;\">주문 조회하기</a>\n    </p>\n    <p style=\"margin: 0; color: #6c757d; font-size: 13px;\">배송이 완료되면 이메일로 다시 알려 드리겠습니다.</p>\n</div>\n            "

