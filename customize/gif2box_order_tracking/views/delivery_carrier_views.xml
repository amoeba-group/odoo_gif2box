<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The "Tracking Link" Odoo offers its fixed-price methods, for the
         distance-priced one too: the courier's page for a parcel, with
         <shipmenttrackingnumber> where the number goes. -->
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="name">delivery.carrier.form.gif2box.tracking</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tracking_url']" position="attributes">
                <attribute name="invisible">delivery_type not in ('fixed', 'base_on_rule', 'gif2box_distance')</attribute>
            </xpath>
            <xpath expr="//field[@name='tracking_url']" position="before">
                <field name="g2b_courier_name"/>
            </xpath>
        </field>
    </record>

</odoo>
