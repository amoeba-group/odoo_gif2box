<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Move the language selector out of the thin top strip and into the action
        row that already holds the search box, cart, wishlist and user menu.

        The strip carried nothing else (the text-element and social-links views
        are inactive on this site, so it rendered as an empty grey band), and it
        is hidden in SCSS once emptied.
    -->
    <template id="header_language_selector_in_actions"
              inherit_id="website.template_header_sales_two">
        <xpath expr="//ul[hasclass('navbar-nav')][hasclass('gap-1')]" position="inside">
            <xpath expr="//t[@t-call='website.placeholder_header_language_selector']"
                   position="move"/>
        </xpath>
        <xpath expr="//t[@t-call='website.placeholder_header_language_selector']/t[@t-set='_div_classes']"
               position="attributes">
            <attribute name="t-valuef">d-flex align-items-center o_gif2box_lang</attribute>
        </xpath>
        <xpath expr="//t[@t-call='website.placeholder_header_language_selector']/t[@t-set='_btn_class']"
               position="attributes">
            <attribute name="t-valuef">btn o_gif2box_lang_btn d-flex align-items-center border-0</attribute>
        </xpath>
    </template>

    <!--
        Shorten the header call to action and give it an icon.

        The label lives inside an `oe_structure`, so it is page content the
        editor owns rather than code. Replacing the anchor here takes that
        button back under version control: it is no longer editable from the
        website editor, which is the trade for having it defined in the module.
    -->
    <template id="header_cta_label" inherit_id="website.header_call_to_action">
        <xpath expr="//a[hasclass('btn_cta')]" position="replace">
            <!--
                The label is the anchor's only content and the phone icon is
                drawn in CSS, on purpose. Odoo extracts a node holding inline
                children as one term including its markup, so an `<i>` beside a
                `<span>` here produced a single msgid full of HTML that nobody
                translated; the button read "Liên hệ" on the Japanese and
                Korean sites too.
            -->
            <a href="/contactus"
               class="oe_unremovable btn btn-primary btn_cta d-flex align-items-center">Contact us</a>
        </xpath>
    </template>

    <!--
        Page loader. Rendered first thing inside the page wrapper so it covers
        everything from the first paint.

        It is not gated on `editable`: that flag is true for anyone who merely
        holds edit rights, not just while the editor is open, so gating on it
        meant staff never saw the loader at all. `loader.js` clears the overlay
        on `load` and again on a timeout, which covers the editor too.
    -->
    <template id="page_loader" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <div id="gif2box_loader" aria-hidden="true">
                <div class="o_gif2box_loader_word"><span
                    class="o_gif2box_word_a">gif2</span><span
                    class="o_gif2box_word_b">box</span></div>
                <div class="o_gif2box_loader_bar"><span/></div>
            </div>
            <!--
                On a page that opens on the hero (the homepage), lift the
                loader as soon as the hero's first slide has its pictures, or
                after 2.5 s at most: the hero paints a blurred stand-in of
                itself at once, so there is never an empty screen to hide.

                Inline, because `loader.js` comes with the lazily loaded
                bundle, which only runs after the whole page has loaded. Held
                on the full page, product rows below included, the loader
                stayed up 14 to 16 s on a slow 4G line while the hero itself
                was ready after 3.

                Written without `&` or `<`, which QWeb would escape.
            -->
            <script>
                (function () {
                    var HERO_WAIT_MS = 2500;
                    function lift() {
                        var loader = document.getElementById("gif2box_loader");
                        if (!loader || loader.classList.contains("o_gif2box_loader_done")) {
                            return;
                        }
                        loader.classList.add("o_gif2box_loader_done");
                        setTimeout(function () {
                            if (loader.parentNode) {
                                loader.parentNode.removeChild(loader);
                            }
                        }, 400);
                    }
                    document.addEventListener("DOMContentLoaded", function () {
                        var hero = document.getElementById("o_g2b_hero");
                        if (!hero) {
                            return;
                        }
                        var images = hero.querySelectorAll(".carousel-item.active img");
                        var pending = images.length;
                        function settled() {
                            pending -= 1;
                            if (pending === 0) {
                                lift();
                            }
                        }
                        Array.prototype.forEach.call(images, function (img) {
                            if (img.complete) {
                                settled();
                            } else {
                                img.addEventListener("load", settled, { once: true });
                                img.addEventListener("error", settled, { once: true });
                            }
                        });
                        if (!images.length) {
                            lift();
                        }
                        setTimeout(lift, HERO_WAIT_MS);
                    });
                })();
            </script>
        </xpath>
    </template>

    <!--
        Odoo already ships the add-to-cart control for the product grids,
        switched off. Enabling it is better than adding our own: it brings the
        `product_id` and `product_template_id` inputs the `/shop/cart/update`
        form needs, and it respects `_website_show_quick_add()`, so products
        that cannot be quick-added keep no button.

        It renders before the price in the markup; CSS moves it after.
    -->
    <record id="website_sale.products_add_to_cart" model="ir.ui.view">
        <field name="active" eval="True"/>
    </record>

    <!--
        Announcement strip above the header.

        To add or remove a banner, edit the list below; everything else
        follows. Each entry carries its own image and the page it links to.

        Controls only render from the second image onwards.
    -->
    <template id="top_banner" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']/header" position="before">
            <t t-set="g2b_banners" t-value="[
                {
                    'src': '/gif2box_theme_home/static/src/img/topbar/banner-1.webp',
                    'url': '/shop/category/gift-38',
                },
            ]"/>
            <div t-if="g2b_banners" class="o_g2b_topbar">
                <div id="o_g2b_topbar_carousel"
                     class="carousel slide"
                     data-bs-ride="carousel"
                     data-bs-interval="5000">
                    <div class="carousel-inner">
                        <div t-foreach="g2b_banners" t-as="banner"
                             t-attf-class="carousel-item #{banner_first and 'active' or ''}">
                            <div class="o_g2b_topbar_slide">
                                <div class="container">
                                    <a class="o_g2b_topbar_link"
                                       t-att-href="banner['url']">
                                        <img class="o_g2b_topbar_img"
                                             t-att-src="banner['src']"
                                             alt=""
                                             loading="eager"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div t-if="len(g2b_banners) &gt; 1" class="carousel-indicators">
                        <button t-foreach="g2b_banners" t-as="banner"
                                type="button"
                                data-bs-target="#o_g2b_topbar_carousel"
                                t-att-data-bs-slide-to="str(banner_index)"
                                t-attf-class="#{banner_first and 'active' or ''}"
                                t-attf-aria-label="Banner #{banner_index + 1}"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!--
        Copyright bar.

        The brand name was carried in page content, where the English arch
        still read "SMD2BOX" and only the Vietnamese translation had been
        updated, so the English site showed the wrong company. Defining it
        here keeps one name across every language, at the cost of it no
        longer being editable from the website editor.

        The Odoo credit is dropped. Only the `t-call` is removed, not the
        column around it: `website.layout` has its own xpath onto that
        column, and taking the node away would break it.
    -->
    <template id="footer_copyright_bar" inherit_id="website.layout">
        <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]"
               position="replace">
            <span class="o_footer_copyright_name me-2">
                Copyright © <strong>gif2box</strong> All rights reserved.
            </span>
        </xpath>
        <xpath expr="//t[@t-call='web.brand_promotion']" position="replace"/>
    </template>

    <!--
        The footer rendered the languages as a flat inline list of links, which
        looked broken once each one carried a flag. Deactivating this view makes
        `portal.footer_language_selector` fall back to its default: the same
        dropdown the header uses, opening upwards.
    -->
    <record id="website.footer_language_selector_inline" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!--
        Show a flag next to each language, both on the toggle button and in the
        dropdown. `res.lang.flag_image_url` falls back to the country flag
        shipped in `base` (vn.png / us.png / jp.png / kr.png here), so nothing
        has to be uploaded.

        The image is appended rather than inserted before the label: the label
        is one of two mutually exclusive spans (`no_text` / `codes`), so there
        is no single stable node to anchor `position="before"` on. The flag is
        pulled back in front with `order: -1` in SCSS instead.
    -->
    <template id="language_selector_flags" inherit_id="portal.language_selector">
        <!--
            Selected on `data-bs-toggle` / the static `dropdown-item` class:
            the template builds the rest of its classes with `t-attf-class`,
            which `hasclass()` cannot see.
        -->
        <xpath expr="//button[@data-bs-toggle='dropdown']" position="inside">
            <img class="o_gif2box_flag"
                 t-att-src="active_lang.flag_image_url"
                 t-att-alt="active_lang.name"
                 loading="lazy"/>
        </xpath>
        <xpath expr="//a[hasclass('dropdown-item')]" position="inside">
            <img class="o_gif2box_flag"
                 t-att-src="lg.flag_image_url"
                 t-att-alt="lg.name"
                 loading="lazy"/>
        </xpath>
    </template>


    <!--
        An icon in front of each top menu entry, chosen by the entry's URL
        (`website.menu._gif2box_icon`, with the table in `models/website.py`).

        Line icons from Lucide (ISC licence), inlined as SVG: they take the
        label's colour, stay sharp at any size, and cost no request. Drawn on
        the desktop bar and in the mobile menu alike, both of which render
        `website.submenu`. An entry with no icon of its own (a page added later
        from the Menu Editor) is drawn as before.

        `aria-hidden`: the label already says what the entry is.

        Elsewhere (the category chips of `gif2box_theme_shop`) the icon is
        named directly, as `g2b_icon_key`, with no menu entry behind it.
    -->
    <template id="menu_icon" name="Menu icon">
        <t t-set="g2b_icon" t-value="g2b_icon_key or submenu._gif2box_icon()"/>
        <svg t-if="g2b_icon"
             t-attf-class="o_g2b_menu_icon o_g2b_menu_icon_#{g2b_icon}"
             viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
            <t t-if="g2b_icon == 'home'">
                <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
                <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </t>
            <t t-elif="g2b_icon == 'about'">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                <path d="M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"/>
                <path d="m18 15-2-2"/>
                <path d="m15 18-2-2"/>
            </t>
            <t t-elif="g2b_icon == 'life'">
                <path d="M9 12h.01"/>
                <path d="M15 12h.01"/>
                <path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/>
                <path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1"/>
            </t>
            <t t-elif="g2b_icon == 'gift'">
                <rect x="3" y="8" width="18" height="4" rx="1"/>
                <path d="M12 8v13"/>
                <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/>
                <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>
            </t>
            <t t-elif="g2b_icon == 'blog'">
                <path d="M12 7v14"/>
                <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>
            </t>
            <t t-elif="g2b_icon == 'shop'">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                <path d="M3 6h18"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
            </t>
            <t t-elif="g2b_icon == 'contact'">
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
            </t>
        </svg>
    </template>

    <template id="submenu_icon" inherit_id="website.submenu">
        <xpath expr="(//a/span[@t-field='submenu.name'])[1]" position="before">
            <t t-call="gif2box_theme_home.menu_icon"/>
        </xpath>
        <xpath expr="(//a/span[@t-field='submenu.name'])[2]" position="before">
            <t t-call="gif2box_theme_home.menu_icon"/>
        </xpath>
    </template>

</odoo>
