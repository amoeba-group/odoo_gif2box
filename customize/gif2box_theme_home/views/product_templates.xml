<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Move the product description below the two columns.

        Odoo renders `description_ecommerce` inside `#product_details`, between
        the title and the price. On this catalogue a description is a stack of
        a dozen full-width marketing images, so the price, the variants and the
        add-to-cart button were pushed several thousand pixels down the page:
        the shopper had to scroll to the very bottom to buy anything.

        The node is moved, not copied, so it stays the same `oe_structure` the
        client edits in the website editor.

        This takes two steps. `position="move"` is only honoured on a direct
        child of the spec element (`tools/template_inheritance.py`), so the
        wrapper is built first and the description is moved into it after,
        rather than nesting the move inside the wrapper markup, which emits the
        `<xpath>` tag itself into the page.

        The wrapper renders whether or not there is a description, so the drop
        zone is still there in the editor for a product that has none; only the
        heading and the read-more control are conditional.
    -->
    <template id="product_description_below" inherit_id="website_sale.product">
        <xpath expr="//div[@id='product_full_description']" position="before">
            <div id="o_g2b_product_desc" class="container o_g2b_fold" data-fold-at="700">
                <h2 t-if="product.description_ecommerce" class="o_g2b_pd_heading">Product details</h2>
                <div id="o_g2b_pd_body" class="o_g2b_pd_body"/>
                <!--
                    Shown by `product_page.js` only when the description is
                    actually long enough to be worth folding away.

                    The two labels are block elements and the chevron is drawn
                    in CSS on purpose: Odoo extracts a node that holds inline
                    children as one term including its markup, so a
                    `<span>`/`<i>` button would have given translators a single
                    msgid full of HTML instead of two plain strings.
                -->
                <div t-if="product.description_ecommerce" class="o_g2b_pd_more_wrap d-none">
                    <button type="button" class="btn o_g2b_pd_more">
                        <div class="o_g2b_pd_label_more">Read more</div>
                        <div class="o_g2b_pd_label_less">Show less</div>
                    </button>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@id='o_g2b_pd_body']" position="inside">
            <xpath expr="//div[@id='product_details']/div[@t-field='product.description_ecommerce']"
                   position="move"/>
        </xpath>
    </template>

    <!--
        Drop the search box from the breadcrumb row.

        The page already sits behind the header search, so a second field
        beside the breadcrumb is a duplicate that steals a third of the row.

        Only the `t-call` goes: deactivating `website_sale.search` would take
        the search off the shop listing too, where it is the only one, and the
        pricelist selector shares this column and has to stay.
    -->
    <template id="product_no_breadcrumb_search" inherit_id="website_sale.product">
        <xpath expr="//section[@id='product_detail']//t[@t-call='website_sale.search']"
               position="replace"/>
    </template>

    <!--
        Drop the "Terms and Conditions" block from the product information
        strip, leaving the share buttons on their own.

        It is Odoo's boilerplate ("30-day money-back guarantee", "Shipping:
        2-3 Business Days") and it contradicts this shop's own policies, which
        are linked from the footer. Deactivating rather than removing the
        markup keeps it a toggle in the editor's Customize panel, so it can be
        switched back on without a code change.

        There is no website-specific copy of this view, so the generic record
        is the one that matters.
    -->
    <record id="website_sale.product_custom_text" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!--
        "Buy now" beside "Add to cart", sending the shopper straight to
        checkout with this product.

        Odoo ships the button, switched off. Enabling it is better than adding
        our own: `website_sale.js` already handles `.o_we_buy_now` (it posts
        the product with `express` set and skips the optional-products
        dialog), disables it with the add-to-cart button when a variant
        combination does not exist, and the label is already translated in
        every language this site runs. It stays a toggle in the editor's
        Customize panel. Styled in `product_page.scss`.

        Odoo itself ignores `express` and puts the product in the cart;
        `gif2box_sale_order_flow` is what checks it out on its own and leaves
        the cart alone.
    -->
    <record id="website_sale.product_buy_now" model="ir.ui.view">
        <field name="active" eval="True"/>
    </record>

    <!--
        Out of stock: say so above the buy form, and keep the form.

        `website_sale_stock` hid the whole form (quantity, "Add to cart",
        "Buy now") and printed its message below where the form had been, or
        printed nothing at all for a combo. The shopper was left with a price
        and no way to tell why there was nothing to press. Now the status
        comes first, where it is read before the buttons, and the buttons stay
        in place, faded and inert (`product_page.scss`, `product_stock_state.js`).

        The status is rendered by `website_sale_stock`'s client template,
        extended in `static/src/xml/stock_status.xml` for the cases it leaves
        silent; it only arrives once the page script has run, which is why
        the form is also marked here, on the server, when the product cannot
        be bought at all. Without it the buttons would show as available for
        the instant before the script catches up.
    -->
    <template id="product_stock_status_first" inherit_id="website_sale.product">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="before">
            <xpath expr="//div[hasclass('availability_messages')]" position="move"/>
        </xpath>
        <!--
            Restated rather than added to: a `t-att-class` beside the static
            `class` replaces it instead of joining it. The list is Odoo's.
        -->
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="attributes">
            <attribute name="class"/>
            <attribute name="t-attf-class">d-flex flex-wrap align-items-center#{' out_of_stock' if product._gif2box_shows_out_of_stock() else ''}</attribute>
        </xpath>
    </template>

    <!--
        The wishlist heart, on the product picture.

        It is a second button that presses the first: Odoo's own stays where
        it is, inside the buy form, hidden, because `website_sale_wishlist.js`
        finds the product to add, and keeps the button's state across variant
        changes, by walking up from the button to that form. Moved out of it,
        the heart would add nothing. `product_stock_state.js` forwards the
        click and mirrors the state back.

        Rendered with the same conditions as Odoo's button, so the two exist
        together or not at all: no combos (Odoo's wishlist does not take
        them) and only while the wishlist button is switched on.
    -->
    <template id="product_wishlist_on_image" inherit_id="website_sale.shop_product_carousel">
        <xpath expr="//div[hasclass('o_carousel_product_outer')]" position="inside">
            <t t-nocache="The wishlist depends on the user and must not be shared with other users. The product come from the controller.">
                <t t-set="g2b_variant" t-value="product and (product_variant or product._create_first_product_variant())"/>
                <t t-set="g2b_in_wish" t-value="g2b_variant and g2b_variant._is_in_wishlist()"/>
                <button t-if="g2b_variant and product.type != 'combo' and is_view_active('website_sale_wishlist.product_add_to_wishlist')"
                        type="button"
                        t-attf-class="o_g2b_wish_on_image #{'o_g2b_wish_active' if g2b_in_wish else ''}"
                        t-att-aria-pressed="'true' if g2b_in_wish else 'false'">
                    <i class="fa fa-heart-o o_g2b_wish_icon_off" aria-hidden="true"/>
                    <i class="fa fa-heart o_g2b_wish_icon_on" aria-hidden="true"/>
                    <!--
                        Both states' names, so they are translated here rather
                        than in the script; the stylesheet keeps the one that
                        matches, and the script copies it to the tooltip.

                        Block elements on purpose, as on the "Read more"
                        button: two `<span>`s side by side were extracted as
                        one term, markup included, and never matched a
                        translation.
                    -->
                    <div class="visually-hidden o_g2b_wish_label_off">Add to wishlist</div>
                    <div class="visually-hidden o_g2b_wish_label_on">In your wishlist</div>
                </button>
            </t>
        </xpath>
    </template>

    <!--
        Put the product's own sales description in the "More Information"
        accordion.

        The block is a real Odoo feature: its body is edited once in the
        website editor and the edit is shared by every product page. It had
        never been edited here, so all it showed was Odoo's shipped
        placeholder, "This content will be shared across all product pages."

        The trade is that the body is no longer editable from the website
        editor. It now comes from the product form (Sales tab, "Sales
        Description"), which is the only place per-product text can live.
    -->
    <template id="product_accordion_description" inherit_id="website_sale.accordion_more_information">

        <!--
            "More Information" was Odoo's label for a block meant to hold text
            shared by every product. It holds this product's own description
            now, so the "More" no longer says anything.

            The whole button is restated because its label is a bare text node
            and view inheritance has no way to reach one. The attributes are
            copied from what this site already renders, which means the
            accordion stays open on arrival exactly as it does today.
        -->
        <xpath expr="//div[@id='more_information_accordion_item']//button" position="replace">
            <button class="accordion-button fw-medium"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#customizable_item"
                    aria-expanded="true"
                    aria-controls="customizable_item">Information</button>
        </xpath>

        <xpath expr="//div[@id='customizable_item']//p" position="replace">
            <!--
                Folded the same way as the description below the buy panel, and
                with the same control: these run to twenty lines of
                specifications followed by the returns policy, which is more
                than an accordion should drop on someone at once.
            -->
            <div class="o_g2b_fold o_g2b_fold_sm" data-fold-at="220">
                <div class="o_g2b_pd_body">
                    <div t-field="product.description_sale" class="o_g2b_short_desc"/>
                </div>
                <div class="o_g2b_pd_more_wrap d-none">
                    <button type="button" class="btn o_g2b_pd_more">
                        <div class="o_g2b_pd_label_more">Read more</div>
                        <div class="o_g2b_pd_label_less">Show less</div>
                    </button>
                </div>
            </div>
        </xpath>
    </template>

    <!--
        Only show the item when the product actually has a description worth
        showing. Most of the catalogue has none, and an accordion that opens
        onto nothing is worse than no accordion. The empty container left
        behind is hidden in `product_page.scss`.

        Six products carried over from the old Cafe24 site have raw HTML in
        this field. It is a Text field, so the converter escapes it and the
        page would show the tags as visible text; those are skipped until the
        data is cleaned up.
    -->
    <template id="product_accordion_hide_when_empty" inherit_id="website_sale.product_accordion">
        <xpath expr="//div[@id='more_information_accordion_item']" position="attributes">
            <attribute name="t-if">is_view_active('website_sale.accordion_more_information') and product.description_sale and not product.description_sale.lstrip().startswith('&lt;')</attribute>
        </xpath>
    </template>

</odoo>
