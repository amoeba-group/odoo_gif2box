<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        "Out of stock" marker for product cards.

        It sits in the action row, in the gap the add-to-cart button leaves
        behind, so the answer is where the question is: the shopper looks for
        the button, and finds the reason it is missing instead.

        The condition matches the one Odoo uses to drop that button
        (`_website_show_quick_add`), so the two always agree. A product flagged
        `allow_out_of_stock_order` is never marked: it can be ordered whatever
        the stock says.

        The caller passes the record as `g2b_product`; it works for both a
        `product.template` and a `product.product`, which is what the dynamic
        snippets hand over.

        The record id stays `out_of_stock_badge` so the existing translations
        keep resolving.
    -->
    <template id="out_of_stock_badge">
        <span t-if="not g2b_product.allow_out_of_stock_order and g2b_product._is_sold_out()"
              class="o_g2b_oos_label">Out of stock</span>
    </template>

    <!--
        The /shop, category and search grid. `.o_wsale_product_btn` is the
        wrapper the cart and wishlist buttons are injected into; the marker
        goes in first, so it takes the cart button's place to the left of the
        wishlist heart.
    -->
    <template id="products_item_out_of_stock" inherit_id="website_sale.products_item">
        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="inside">
            <t t-call="gif2box_theme_home.out_of_stock_badge">
                <t t-set="g2b_product" t-value="product"/>
            </t>
        </xpath>
    </template>

    <!--
        Homepage carousel ("Classic Card"). The button's wrapper carries its
        own `t-if`, so when it is not rendered this lands in exactly its spot,
        opposite the price.
    -->
    <template id="dynamic_card_out_of_stock"
              inherit_id="website_sale.dynamic_filter_template_product_product_add_to_cart">
        <xpath expr="//div[hasclass('o_dynamic_snippet_btn_wrapper')]" position="after">
            <t t-call="gif2box_theme_home.out_of_stock_badge">
                <t t-set="g2b_product" t-value="record"/>
            </t>
        </xpath>
    </template>

    <!--
        Drop the empty row between the product name and the price.

        The snippet card reserves a `mt-2` div for the review stars, which only
        render when `website_sale.product_comment` is active. It is not, so
        every card carried an empty div and the margin that goes with it.

        A `t-if` on the div rather than deleting it: the same condition its one
        child already carries, so the row comes back by itself if reviews are
        ever switched on. `:empty` in CSS cannot do this: QWeb leaves the
        indentation inside the div, and whitespace is content as far as that
        selector is concerned.
    -->
    <template id="dynamic_card_no_empty_rating"
              inherit_id="website_sale.dynamic_filter_template_product_product_add_to_cart">
        <xpath expr="//div[hasclass('o_carousel_product_card_body')]/div[hasclass('mt-2')]"
               position="attributes">
            <attribute name="t-if">is_view_active('website_sale.product_comment')</attribute>
        </xpath>
    </template>

    <!--
        "Borderless Product n°1" has no add-to-cart button at all, so the
        marker follows the price, which is the only thing in its action row.
    -->
    <template id="dynamic_card_borderless_out_of_stock"
              inherit_id="website_sale.dynamic_filter_template_product_product_borderless_1">
        <xpath expr="//div[hasclass('o_carousel_product_card_body')]//div[hasclass('mt-2')]"
               position="inside">
            <t t-call="gif2box_theme_home.out_of_stock_badge">
                <t t-set="g2b_product" t-value="record"/>
            </t>
        </xpath>
    </template>

</odoo>
