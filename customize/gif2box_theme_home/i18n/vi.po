#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "About Gif2box"
msgstr "Về Gif2box"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Gifts for little ones, ready to give"
msgstr "Quà cho bé, sẵn sàng để trao tặng"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Gif2box brings together authentic Korean baby feeding and care essentials in gift sets for every milestone: chosen with care, boxed with love, delivered ready to hand over."
msgstr "Gif2box tuyển chọn đồ dùng ăn dặm và chăm sóc bé chính hãng Hàn Quốc thành những set quà cho từng cột mốc của bé: chọn lựa kỹ càng, đóng hộp chỉn chu, giao tận tay sẵn sàng để trao tặng."

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Choose a gift box"
msgstr "Chọn hộp quà"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Browse single items"
msgstr "Xem sản phẩm lẻ"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Authentic Korean brands"
msgstr "Thương hiệu Hàn Quốc chính hãng"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Free shipping from 500,000₫"
msgstr "Miễn phí vận chuyển từ 500.000₫"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Delivered nationwide"
msgstr "Giao hàng toàn quốc"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "The idea"
msgstr "Ý tưởng"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "One box, everything the occasion needs"
msgstr "Một hộp quà, đủ mọi thứ cho dịp đặc biệt"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Choosing a present for a newborn or a first birthday can take hours: which brand is safe, which pieces go together, what the family will really use. A Gif2box gift set answers all of it at once: a complete, coordinated set of everyday essentials, in one box, for less than buying each piece."
msgstr "Chọn quà cho bé sơ sinh hay bé tròn 1 tuổi có thể mất hàng giờ: thương hiệu nào an toàn, món nào đi cùng nhau, gia đình sẽ thực sự dùng gì. Set quà Gif2box giải quyết tất cả cùng lúc: trọn bộ đồ dùng hằng ngày được phối sẵn, trong một hộp, với giá thấp hơn mua lẻ từng món."

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Curated for the moment"
msgstr "Chọn sẵn theo từng dịp"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Each set is built around a milestone, from welcoming a newborn to a first birthday, with pieces the family will actually use every day."
msgstr "Mỗi set được xây dựng quanh một cột mốc, từ chào đón bé chào đời đến sinh nhật đầu tiên, với những món gia đình thực sự dùng mỗi ngày."

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Boxed and ready to give"
msgstr "Đóng hộp sẵn để tặng"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Sets come in a gift box, so they go from the doorstep straight into your hands, with no wrapping to sort out."
msgstr "Set quà được đóng trong hộp quà, nhận hàng là có thể trao tay ngay, không cần lo khâu gói quà."

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Better value than buying separately"
msgstr "Tiết kiệm hơn mua lẻ"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "A set costs less than its items bought one by one, and every set's page shows exactly how much you save."
msgstr "Giá một set thấp hơn tổng giá các món mua lẻ, và trang của từng set ghi rõ bạn tiết kiệm được bao nhiêu."

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Safe materials, authentic brands"
msgstr "Chất liệu an toàn, thương hiệu chính hãng"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Platinum silicone, PPSU and 304 stainless steel, from Korean brands such as Firgi, Le Made and Standard145."
msgstr "Silicone bạch kim, nhựa PPSU và inox 304, từ các thương hiệu Hàn Quốc như Firgi, Le Made và Standard145."

