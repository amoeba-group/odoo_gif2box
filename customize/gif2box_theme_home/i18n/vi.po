#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "A gift sorted in four steps"
msgstr "Chọn quà chỉ với 4 bước"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Pick the occasion"
msgstr "Chọn dịp tặng"

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "A newborn, a first birthday, a baby starting solids, or simply a thoughtful present."
msgstr "Chào đón bé sơ sinh, mừng thôi nôi, bé bắt đầu ăn dặm, hay đơn giản là một món quà ý nghĩa."

#. module: gif2box_theme_home
#: model_terms:ir.ui.view,arch_db:gif2box_theme_home.about_us_content
msgid "Open a set to see every item inside, with its picture and its price on its own."
msgstr "Mở trang set quà để xem từng món bên trong, kèm hình ảnh và giá mua lẻ."

