<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The hero, right under the header of the homepage.

        Rendered by the server as part of the page rather than fetched by a
        script afterwards: it is the first and largest thing a visitor sees,
        and the picture is what the browser should start loading first.

        It sits outside `#wrap`, so the website editor leaves it alone; it is
        edited from Website > Site > Hero Banners. Nothing renders until at
        least one banner is active, so installing the module changes nothing
        on the site by itself.
    -->
    <template id="hero_banner_layout" inherit_id="website.layout" name="Homepage hero banner">
        <!--
            The first slide's pictures, announced at the top of the page: the
            browser starts fetching them while it is still reading the head,
            instead of after the stylesheets and the markup above the hero.
        -->
        <xpath expr="//head/meta[last()]" position="after">
            <t t-if="website and website._gif2box_is_homepage(main_object)">
                <t t-set="g2b_lead" t-value="website._gif2box_hero_banners()[:1]"/>
                <t t-if="g2b_lead" t-call="gif2box_hero_banner.hero_banner_preload">
                    <t t-set="hero" t-value="g2b_lead"/>
                </t>
            </t>
        </xpath>
        <xpath expr="//main/t[@t-out='0']" position="before">
            <t t-if="website and website._gif2box_is_homepage(main_object)">
                <t t-set="g2b_heroes" t-value="website._gif2box_hero_banners()"/>
                <t t-if="g2b_heroes" t-call="gif2box_hero_banner.hero_banner"/>
            </t>
        </xpath>
    </template>

    <template id="hero_banner_preload" name="Hero banner preload">
        <t t-set="g2b_has_mobile" t-value="hero._gif2box_has_picture('image_mobile')"/>
        <link rel="preload" as="image" fetchpriority="high"
              t-att-href="hero._gif2box_picture_url('image_desktop_web')"
              t-att-imagesrcset="hero._gif2box_background_srcset()"
              imagesizes="100vw"
              t-att-media="g2b_has_mobile and '(min-width: 768px)'"/>
        <link t-if="g2b_has_mobile" rel="preload" as="image" fetchpriority="high"
              t-att-href="hero._gif2box_picture_url('image_mobile_web')"
              media="(max-width: 767.98px)"/>
        <link t-if="hero._gif2box_show_product()" rel="preload" as="image" fetchpriority="high"
              t-att-href="hero._gif2box_picture_url('image_product_web')"
              t-att-imagesrcset="hero._gif2box_product_srcset()"
              t-att-imagesizes="hero._gif2box_product_sizes()"/>
    </template>

    <template id="hero_banner" name="Hero banner">
        <t t-set="g2b_multiple" t-value="len(g2b_heroes) &gt; 1"/>
        <!--
            Protected from the website editor: the hero is edited from its own
            form, and its slides keep turning while the page is being edited.
            Unprotected, each turn counted as a change to the page, and the
            editor undid any other change made in the same instant: deleting
            a block below the hero would not stick.
        -->
        <section id="o_g2b_hero"
                 data-oe-protected="true"
                 t-attf-class="o_g2b_hero carousel slide carousel-fade"
                 t-att-data-bs-ride="g2b_multiple and 'carousel'"
                 data-bs-interval="6000"
                 data-bs-pause="hover"
                 aria-roledescription="carousel">

            <!-- The pictures fade in from `onload`; without scripts they just show. -->
            <noscript><style>#o_g2b_hero .o_g2b_hero_img, #o_g2b_hero .o_g2b_hero_product img { opacity: 1 !important; }</style></noscript>

            <div class="carousel-inner">
                <t t-foreach="g2b_heroes" t-as="hero">
                    <div t-attf-class="carousel-item o_g2b_hero_slide o_g2b_hero_#{hero.content_position} o_g2b_hero_text_#{hero.text_theme} o_g2b_hero_title_#{hero.title_style} #{hero_first and 'active' or ''}"
                         t-att-style="hero._gif2box_size_style()">

                        <!--
                            Layer one: the background, edge to edge. It is
                            decoration once there is a product or a title in
                            front of it, so it then carries no alt text; on its
                            own it is the whole message and is named.
                        -->
                        <!--
                            The pictures load in this order, and never as one
                            slow block:
                            - a 32 px blur of the background, inlined in the
                              page, is there at once (`_gif2box_placeholder_style`);
                            - the first slide's pictures are fetched first,
                              eagerly (Odoo would otherwise mark every picture
                              `lazy`) and announced in the head;
                            - each picture fades in once it has arrived
                              (`o_g2b_loaded`, set by `onload`), rather than
                              being painted top to bottom as it downloads;
                            - the other slides wait until the page has loaded
                              (`hero_banner.js`), so they never compete with it.
                            All are the light copies made when the banner is
                            saved, in the size the screen needs (`srcset`).
                        -->
                        <picture class="o_g2b_hero_media" t-att-style="hero._gif2box_placeholder_style()">
                            <source t-if="hero._gif2box_has_picture('image_mobile')"
                                    media="(max-width: 767.98px)"
                                    t-att-srcset="hero._gif2box_picture_url('image_mobile_web')"/>
                            <img class="o_g2b_hero_img"
                                 t-att-src="hero._gif2box_picture_url('image_desktop_web')"
                                 t-att-srcset="hero._gif2box_background_srcset()"
                                 sizes="100vw"
                                 width="1920" height="528"
                                 t-att-alt="'' if (hero.title or hero._gif2box_has_picture('image_product')) else hero.name"
                                 t-att-loading="'eager' if hero_first else 'lazy'"
                                 t-att-fetchpriority="hero_first and 'high' or 'low'"
                                 t-att-decoding="'auto' if hero_first else 'async'"
                                 onload="this.classList.add('o_g2b_loaded')"
                                 onerror="this.classList.add('o_g2b_loaded')"/>
                        </picture>

                        <!-- Layer two: the product and the words, held to the width of the page. -->
                        <div class="o_g2b_hero_overlay">
                            <div class="container o_g2b_hero_grid">
                                <div t-if="hero._gif2box_show_product()" class="o_g2b_hero_product">
                                    <img t-att-src="hero._gif2box_picture_url('image_product_web')"
                                         t-att-srcset="hero._gif2box_product_srcset()"
                                         t-att-sizes="hero._gif2box_product_sizes()"
                                         t-att-alt="hero.title or hero.name"
                                         t-att-loading="'eager' if hero_first else 'lazy'"
                                         t-att-fetchpriority="hero_first and 'high' or 'low'"
                                         t-att-decoding="'auto' if hero_first else 'async'"
                                         onload="this.classList.add('o_g2b_loaded')"
                                         onerror="this.classList.add('o_g2b_loaded')"/>
                                </div>
                                <div t-if="hero.title or hero.description or hero._gif2box_show_button()"
                                     class="o_g2b_hero_content">
                                    <h2 t-if="hero.title" class="o_g2b_hero_title" t-out="hero.title"/>
                                    <p t-if="hero.description" class="o_g2b_hero_desc" t-out="hero.description"/>
                                    <a t-if="hero._gif2box_show_button()"
                                       class="o_g2b_hero_btn"
                                       t-att-href="hero.button_url">
                                        <span t-out="hero.button_text"/>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- A link but no button text: the whole slide is the link. -->
                        <a t-if="hero._gif2box_link_whole_slide()"
                           class="o_g2b_hero_cover_link"
                           t-att-href="hero.button_url"
                           t-att-aria-label="hero.title or hero.name"/>
                    </div>
                </t>
            </div>

            <t t-if="g2b_multiple">
                <!-- Labelled by attribute, not by an inner span: the extractor
                     would otherwise take the span's markup into the term. -->
                <button class="carousel-control-prev o_g2b_hero_ctrl" type="button"
                        data-bs-target="#o_g2b_hero" data-bs-slide="prev" aria-label="Previous"/>
                <button class="carousel-control-next o_g2b_hero_ctrl" type="button"
                        data-bs-target="#o_g2b_hero" data-bs-slide="next" aria-label="Next"/>
                <div class="carousel-indicators o_g2b_hero_dots">
                    <button t-foreach="g2b_heroes" t-as="hero" type="button"
                            data-bs-target="#o_g2b_hero"
                            t-att-data-bs-slide-to="str(hero_index)"
                            t-att-class="hero_first and 'active'"
                            t-att-aria-current="hero_first and 'true'"
                            t-att-aria-label="hero.title or hero.name"/>
                </div>
            </t>

            <!-- A shortcut to the banners, for the people who edit them. -->
            <a groups="website.group_website_designer"
               class="o_g2b_hero_edit"
               href="/odoo/action-gif2box_hero_banner.website_hero_banner_action">Edit banners</a>
        </section>
    </template>

    <!--
        The preview on the banner form. The backend does not load the site's
        stylesheets, so it is styled inline, to the same proportions and
        colours as the real one.
    -->
    <template id="hero_banner_preview" name="Hero banner preview">
        <t t-set="dark" t-value="banner.text_theme == 'dark'"/>
        <t t-set="centred" t-value="banner.content_position == 'center'"/>
        <t t-set="show_product" t-value="product_src and not centred"/>
        <t t-set="serif" t-value="banner.title_style != 'sans'"/>
        <div t-attf-style="position: relative; width: 100%; aspect-ratio: 1920 / 528; min-height: 200px; container-type: inline-size; border-radius: 14px; overflow: hidden; background: #{image_src and ('url(%s) center / cover no-repeat' % image_src) or 'repeating-linear-gradient(45deg, #f4f1ef 0 14px, #ece7e3 14px 28px)'}; box-shadow: 0 6px 20px rgba(0,0,0,.08); font-family: inherit;">
            <div t-attf-style="position: absolute; inset: 0; display: flex; align-items: center; gap: 4%; padding: 0 7%; flex-direction: #{'row-reverse' if banner.content_position == 'left' else 'row'}; justify-content: #{centred and 'center' or 'space-between'};">
                <div t-if="show_product" style="flex: 1 1 38%; height: 100%; display: flex; align-items: center; justify-content: center;">
                    <img t-att-src="product_src" style="max-height: 88%; max-width: 100%; object-fit: contain;" alt=""/>
                </div>
                <div t-attf-style="flex: 1 1 62%; max-width: #{show_product and '62%' or '64%'}; text-align: #{centred and 'center' or 'left'};">
                    <div t-if="banner.title"
                         t-attf-style="font-family: #{serif and 'Noto Serif, Times New Roman, Times, Georgia, serif' or 'inherit'}; font-size: #{banner.title_font_size / 19.2}cqw; font-weight: 700; line-height: 1.22; letter-spacing: #{serif and '.04em' or '.01em'}; text-transform: uppercase; white-space: pre-line; color: #{dark and '#1a1a1a' or '#ffffff'}; margin-bottom: 10px;"
                         t-out="banner.title"/>
                    <div t-if="banner.description"
                         t-attf-style="font-size: #{banner.description_font_size / 19.2}cqw; font-weight: 600; line-height: 1.4; color: #{dark and '#EE6A2C' or 'rgba(255,255,255,.92)'}; margin-bottom: 16px; white-space: pre-line;"
                         t-out="banner.description"/>
                    <span t-if="banner.button_text"
                          t-attf-style="display: inline-block; padding: .72em 1.9em; border-radius: 999px; background: linear-gradient(180deg, #F26A35 0%, #DE4E1A 100%); color: #ffffff; font-size: #{banner.button_font_size / 19.2}cqw; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; box-shadow: 0 6px 14px rgba(222,78,26,.32), inset 0 1px 0 rgba(255,255,255,.25);"
                          t-out="banner.button_text"/>
                </div>
            </div>
            <div t-if="not image_src"
                 style="position: absolute; left: 0; right: 0; bottom: 12px; text-align: center; font-size: 12px; color: #8a8f94;">
                Add a background image to see the banner.
            </div>
        </div>
    </template>

</odoo>
