<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The 63 delivery areas, with their distance from the warehouse and
        the price column each one pays. Edited in the list itself: a
        distance or a pricing is a click, and the "Price Column" shows at
        once what it gives. No create or delete: the areas are the former
        provinces, fixed, and every ward points at one.
    -->
    <record id="delivery_area_view_list" model="ir.ui.view">
        <field name="name">gif2box.delivery.area.list</field>
        <field name="model">gif2box.delivery.area</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="seat" readonly="1"/>
                <field name="state_id" readonly="1" options="{'no_open': True}"/>
                <field name="distance_km"/>
                <field name="pricing"/>
                <field name="zone"
                       decoration-success="zone == 'inner'"
                       decoration-info="zone == 'near'"
                       decoration-warning="zone == 'far'"
                       decoration-primary="zone == 'hub'"
                       widget="badge"/>
                <field name="ward_count"/>
                <button name="action_view_wards" type="object" string="Wards"
                        icon="fa-map-marker" class="btn-link"/>
                <field name="code" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="delivery_area_view_form" model="ir.ui.view">
        <field name="name">gif2box.delivery.area.form</field>
        <field name="model">gif2box.delivery.area</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_wards" type="object"
                                class="oe_stat_button" icon="fa-map-marker">
                            <field name="ward_count" widget="statinfo" string="Wards"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="seat" readonly="1"/>
                            <field name="state_id" readonly="1"/>
                            <field name="code" readonly="1"/>
                        </group>
                        <group>
                            <field name="distance_km"/>
                            <field name="pricing"/>
                            <field name="zone" widget="badge"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="delivery_area_view_search" model="ir.ui.view">
        <field name="name">gif2box.delivery.area.search</field>
        <field name="model">gif2box.delivery.area</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="seat"/>
                <field name="state_id"/>
                <filter name="inner" string="Inner city" domain="[('pricing', '=', 'inner')]"/>
                <filter name="hub" string="Hà Nội &amp; Đà Nẵng" domain="[('pricing', '=', 'hub')]"/>
                <filter name="distance" string="By distance" domain="[('pricing', '=', 'distance')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Province Today" context="{'group_by': 'state_id'}"/>
                    <filter name="group_pricing" string="Pricing" context="{'group_by': 'pricing'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_delivery_area" model="ir.actions.act_window">
        <field name="name">Delivery Areas</field>
        <field name="res_model">gif2box.delivery.area</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="delivery_area_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No delivery area</p>
            <p>
                The areas are the provinces as they were before July 2025, with their road distance from the warehouse. They are created when the module is installed.
            </p>
        </field>
    </record>

    <menuitem id="menu_ecommerce_delivery_area"
              action="action_delivery_area"
              parent="website_sale.menu_ecommerce_settings"
              sequence="91"/>

    <menuitem id="menu_sale_delivery_area"
              action="action_delivery_area"
              parent="sale.menu_sales_config"
              sequence="5"/>

    <!-- Which area each ward is priced as, in the ward register. -->
    <record id="res_country_ward_view_list" model="ir.ui.view">
        <field name="name">res.country.ward.list.delivery.area</field>
        <field name="model">res.country.ward</field>
        <field name="inherit_id" ref="gif2box_vn_address.res_country_ward_view_list"/>
        <field name="arch" type="xml">
            <field name="state_id" position="after">
                <field name="g2b_area_id"/>
            </field>
        </field>
    </record>

    <record id="res_country_ward_view_form" model="ir.ui.view">
        <field name="name">res.country.ward.form.delivery.area</field>
        <field name="model">res.country.ward</field>
        <field name="inherit_id" ref="gif2box_vn_address.res_country_ward_view_form"/>
        <field name="arch" type="xml">
            <field name="state_id" position="after">
                <field name="g2b_area_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

</odoo>
