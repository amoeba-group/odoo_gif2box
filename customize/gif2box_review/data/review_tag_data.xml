<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The highlights a reviewer taps instead of typing. Givers talk about
        giving (the wrapping, the timing, the reaction), recipients about
        receiving. noupdate: the shop edits them in Reviews > Highlights.
    -->
    <data noupdate="1">

        <!-- Gift givers -->
        <record id="tag_buyer_wrapping" model="gif2box.review.tag">
            <field name="name">Beautifully wrapped</field>
            <field name="icon">🎁</field>
            <field name="review_type">buyer</field>
            <field name="sequence">10</field>
        </record>
        <record id="tag_buyer_loved" model="gif2box.review.tag">
            <field name="name">They loved it</field>
            <field name="icon">🥰</field>
            <field name="review_type">buyer</field>
            <field name="sequence">20</field>
        </record>
        <record id="tag_buyer_on_time" model="gif2box.review.tag">
            <field name="name">Arrived on time</field>
            <field name="icon">⏰</field>
            <field name="review_type">buyer</field>
            <field name="sequence">30</field>
        </record>
        <record id="tag_buyer_easy" model="gif2box.review.tag">
            <field name="name">Easy to order</field>
            <field name="icon">👌</field>
            <field name="review_type">buyer</field>
            <field name="sequence">40</field>
        </record>
        <record id="tag_buyer_helpful" model="gif2box.review.tag">
            <field name="name">Helpful support</field>
            <field name="icon">💬</field>
            <field name="review_type">buyer</field>
            <field name="sequence">50</field>
        </record>
        <record id="tag_buyer_value" model="gif2box.review.tag">
            <field name="name">Worth the price</field>
            <field name="icon">💰</field>
            <field name="review_type">buyer</field>
            <field name="sequence">60</field>
        </record>

        <!-- Gift recipients -->
        <record id="tag_recipient_box" model="gif2box.review.tag">
            <field name="name">Such a cute box</field>
            <field name="icon">🎀</field>
            <field name="review_type">recipient</field>
            <field name="sequence">110</field>
        </record>
        <record id="tag_recipient_surprise" model="gif2box.review.tag">
            <field name="name">What a lovely surprise</field>
            <field name="icon">😍</field>
            <field name="review_type">recipient</field>
            <field name="sequence">120</field>
        </record>
        <record id="tag_recipient_quality" model="gif2box.review.tag">
            <field name="name">Great quality</field>
            <field name="icon">✨</field>
            <field name="review_type">recipient</field>
            <field name="sequence">130</field>
        </record>
        <record id="tag_recipient_safe" model="gif2box.review.tag">
            <field name="name">Safe for my baby</field>
            <field name="icon">👶</field>
            <field name="review_type">recipient</field>
            <field name="sequence">140</field>
        </record>
        <record id="tag_recipient_careful" model="gif2box.review.tag">
            <field name="name">Carefully packed</field>
            <field name="icon">📦</field>
            <field name="review_type">recipient</field>
            <field name="sequence">150</field>
        </record>
        <record id="tag_recipient_card" model="gif2box.review.tag">
            <field name="name">Sweet thank-you card</field>
            <field name="icon">💌</field>
            <field name="review_type">recipient</field>
            <field name="sequence">160</field>
        </record>

    </data>

</odoo>
