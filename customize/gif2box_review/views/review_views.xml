<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================
         Reviews
         ================================================================= -->

    <record id="view_review_list" model="ir.ui.view">
        <field name="name">gif2box.review.list</field>
        <field name="model">gif2box.review</field>
        <field name="arch" type="xml">
            <list string="Reviews" decoration-muted="not is_published">
                <field name="review_date" widget="date"/>
                <field name="review_type" widget="badge"
                       decoration-warning="review_type == 'buyer'"
                       decoration-info="review_type == 'recipient'"/>
                <field name="product_tmpl_id"/>
                <field name="rating" widget="g2b_rating_stars"/>
                <field name="author_name"/>
                <field name="comment" class="o_g2b_rv_list_comment"/>
                <field name="image_count" string="Photos" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="source" optional="hide"/>
                <!-- Not `reply` as a checkbox: a text field crashes the
                     boolean widget when Owl checks its props (debug mode). -->
                <field name="reply_date" string="Replied" widget="date" optional="show"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_review_kanban" model="ir.ui.view">
        <field name="name">gif2box.review.kanban</field>
        <field name="model">gif2box.review</field>
        <field name="arch" type="xml">
            <kanban class="o_g2b_rv_kanban" sample="1">
                <field name="image_ids"/>
                <field name="is_published"/>
                <templates>
                    <t t-name="card" class="flex-row p-0">
                        <aside class="o_g2b_rv_kanban_photo">
                            <img t-if="record.image_ids.raw_value.length"
                                 t-att-src="'/web/image/gif2box.review.image/' + record.image_ids.raw_value[0] + '/image_256'"
                                 alt="Photo" class="w-100 h-100 object-fit-cover"/>
                            <span t-else="" class="o_g2b_rv_kanban_nophoto fa fa-commenting-o" title="No photo"/>
                        </aside>
                        <main class="flex-grow-1 p-2 overflow-hidden">
                            <div class="d-flex align-items-center gap-2">
                                <field name="rating" widget="g2b_rating_stars" readonly="1"/>
                                <field name="review_type" widget="badge"
                                       decoration-warning="review_type == 'buyer'"
                                       decoration-info="review_type == 'recipient'"/>
                                <span t-if="!record.is_published.raw_value" class="badge text-bg-secondary ms-auto">Hidden</span>
                            </div>
                            <field name="product_tmpl_id" class="fw-bold text-truncate d-block mt-1"/>
                            <div class="text-muted small">
                                <field name="author_name"/>
                                <span class="mx-1">·</span>
                                <field name="review_date" widget="date"/>
                            </div>
                            <field name="comment" class="o_g2b_rv_kanban_comment small mt-1"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_review_form" model="ir.ui.view">
        <field name="name">gif2box.review.form</field>
        <field name="model">gif2box.review</field>
        <field name="arch" type="xml">
            <form string="Review">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="is_published"/>
                    <button name="action_unpublish" type="object" string="Hide from the website"
                            invisible="not is_published"/>
                    <field name="source" widget="statusbar" statusbar_visible="order,card,shop"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_order" type="object" class="oe_stat_button"
                                icon="fa-shopping-bag" invisible="not order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Order</span>
                                <span class="o_stat_value"><field name="order_id" readonly="1" options="{'no_open': True}"/></span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Hidden" bg_color="text-bg-secondary" invisible="is_published"/>
                    <div class="oe_title">
                        <label for="rating"/>
                        <h1><field name="rating" widget="g2b_rating_stars" class="o_g2b_rv_stars_lg"/></h1>
                        <field name="rating_label" class="text-muted"/>
                    </div>
                    <group>
                        <group string="Who">
                            <field name="review_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="author_name"/>
                            <field name="is_anonymous"/>
                            <field name="display_author" invisible="not is_anonymous"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="About">
                            <field name="product_tmpl_id"/>
                            <field name="product_id" groups="product.group_product_variant"
                                   options="{'no_create': True}"/>
                            <field name="order_id" options="{'no_create': True}"/>
                            <field name="order_line_id" options="{'no_create': True}"
                                   domain="[('order_id', '=', order_id)]" invisible="not order_id"/>
                            <field name="review_date"/>
                            <field name="verified"/>
                            <field name="is_published"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Review" name="review">
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                                   placeholder="Highlights..."/>
                            <field name="comment" placeholder="What they wrote..."/>
                            <separator string="Photos"/>
                            <field name="image_ids" mode="kanban" class="o_g2b_rv_images"
                                   context="{'default_review_id': id}">
                                <kanban>
                                    <field name="sequence"/>
                                    <templates>
                                        <t t-name="card" class="p-0">
                                            <field name="image_1920" widget="image" options="{'preview_image': 'image_256'}"
                                                   class="o_g2b_rv_image_card"/>
                                        </t>
                                    </templates>
                                </kanban>
                                <form string="Photo">
                                    <field name="image_1920" widget="image" options="{'preview_image': 'image_1024'}"/>
                                    <group>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Shop reply" name="reply">
                            <field name="reply" placeholder="Thank them, or answer a concern. Shown under the review on the product page."/>
                            <group>
                                <field name="reply_date" invisible="not reply_date"/>
                            </group>
                        </page>
                        <page string="Note to the giver" name="thanks" invisible="review_type != 'recipient'">
                            <p class="text-muted">Private: shown to the buyer on their order, never on the product page.</p>
                            <field name="thanks_note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_review_search" model="ir.ui.view">
        <field name="name">gif2box.review.search</field>
        <field name="model">gif2box.review</field>
        <field name="arch" type="xml">
            <search string="Reviews">
                <field name="product_tmpl_id"/>
                <field name="author_name"/>
                <field name="comment"/>
                <field name="order_id"/>
                <field name="tag_ids"/>
                <filter name="filter_all" string="All" domain="[]" invisible="1"/>
                <filter name="filter_published" string="Published" domain="[('is_published', '=', True)]"/>
                <filter name="filter_hidden" string="Hidden or waiting" domain="[('is_published', '=', False)]"/>
                <separator/>
                <filter name="filter_buyer" string="By gift givers" domain="[('review_type', '=', 'buyer')]"/>
                <filter name="filter_recipient" string="By gift recipients" domain="[('review_type', '=', 'recipient')]"/>
                <separator/>
                <filter name="filter_photos" string="With photos" domain="[('image_count', '>', 0)]"/>
                <filter name="filter_low" string="3 stars or fewer" domain="[('rating', '&lt;=', 3)]"/>
                <filter name="filter_no_reply" string="Not replied to" domain="[('reply', '=', False)]"/>
                <filter name="filter_note" string="With a note to the giver" domain="[('thanks_note', '!=', False)]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="review_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter name="group_type" string="Written by" context="{'group_by': 'review_type'}"/>
                    <filter name="group_rating" string="Rating" context="{'group_by': 'rating'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'review_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reviews" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">gif2box.review</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_review_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reviews yet</p>
            <p>
                Gift givers review their order from "My orders" once it has left. Recipients
                scan the QR code of the thank-you card in the box: print the cards from the order
                or the delivery order ("Thank-you card").
            </p>
            <p>You can also add a review here, for one sent by chat or email.</p>
        </field>
    </record>

    <!-- =================================================================
         Highlights (tags)
         ================================================================= -->

    <record id="view_review_tag_list" model="ir.ui.view">
        <field name="name">gif2box.review.tag.list</field>
        <field name="model">gif2box.review.tag</field>
        <field name="arch" type="xml">
            <list string="Highlights" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="icon" width="60px"/>
                <field name="name"/>
                <field name="review_type"/>
                <field name="color" widget="color_picker"/>
                <field name="review_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_review_tags" model="ir.actions.act_window">
        <field name="name">Review Highlights</field>
        <field name="res_model">gif2box.review.tag</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a highlight</p>
            <p>Short phrases reviewers tap instead of typing, like "Beautifully wrapped".</p>
        </field>
    </record>

</odoo>
