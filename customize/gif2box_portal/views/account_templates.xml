<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================
         Pieces
         ================================================================= -->

    <!-- Lucide icons, inlined: they take the colour of the text. -->
    <template id="icon" name="Account: icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"
             t-attf-class="o_g2b_icon #{g2b_icon_class or ''}">
            <t t-if="g2b_icon == 'home'">
                <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
                <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </t>
            <t t-elif="g2b_icon == 'package'">
                <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/>
                <path d="M12 22V12"/>
                <path d="m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7"/>
                <path d="m7.5 4.27 9 5.15"/>
            </t>
            <t t-elif="g2b_icon == 'heart'">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
            </t>
            <t t-elif="g2b_icon == 'user'">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </t>
            <t t-elif="g2b_icon == 'logout'">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" x2="9" y1="12" y2="12"/>
            </t>
            <t t-elif="g2b_icon == 'truck'">
                <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
                <path d="M15 18H9"/>
                <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/>
                <circle cx="17" cy="18" r="2"/>
                <circle cx="7" cy="18" r="2"/>
            </t>
            <t t-elif="g2b_icon == 'star'">
                <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>
            </t>
            <t t-elif="g2b_icon == 'chevron'">
                <path d="m9 18 6-6-6-6"/>
            </t>
            <t t-elif="g2b_icon == 'phone'">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </t>
            <t t-elif="g2b_icon == 'lock'">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </t>
            <t t-elif="g2b_icon == 'pin'">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                <circle cx="12" cy="10" r="3"/>
            </t>
            <t t-elif="g2b_icon == 'mail'">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </t>
            <t t-elif="g2b_icon == 'bag'">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                <path d="M3 6h18"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
            </t>
            <t t-elif="g2b_icon == 'search'">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
            </t>
            <t t-elif="g2b_icon == 'pencil'">
                <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/>
            </t>
        </svg>
    </template>

    <!-- The customer's name, and the account's tabs. -->
    <template id="account_header" name="Account: header and tabs">
        <t t-set="g2b_me" t-value="request.env.user.partner_id"/>
        <!-- From the path: Odoo's pages do not all set `page_name`. -->
        <t t-set="g2b_path" t-value="request.httprequest.path.rstrip('/')"/>
        <t t-set="g2b_tab" t-value="'orders' if ('/my/orders' in g2b_path or '/my/quotes' in g2b_path) else 'profile' if ('/my/account' in g2b_path or '/my/security' in g2b_path) else 'home' if (g2b_path.endswith('/my') or g2b_path.endswith('/my/home')) else ''"/>
        <header class="o_g2b_acc_head">
            <div class="o_g2b_acc_avatar" aria-hidden="true"
                 t-out="((g2b_me.name or '?').split() or ['?'])[-1][:1].upper()"/>
            <div class="o_g2b_acc_who">
                <div class="o_g2b_acc_hello">Hello,</div>
                <div class="o_g2b_acc_name" t-out="g2b_me.name"/>
            </div>
            <a href="/web/session/logout?redirect=/" class="o_g2b_acc_logout">
                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'logout'"/></t>
                <span>Log out</span>
            </a>
        </header>
        <nav class="o_g2b_acc_nav" aria-label="My account">
            <a href="/my/home" t-attf-class="o_g2b_acc_tab #{'is-active' if g2b_tab == 'home' else ''}"
               t-att-aria-current="'page' if g2b_tab == 'home' else None">
                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'home'"/></t>
                <span>Overview</span>
            </a>
            <a href="/my/orders" t-attf-class="o_g2b_acc_tab #{'is-active' if g2b_tab == 'orders' else ''}"
               t-att-aria-current="'page' if g2b_tab == 'orders' else None">
                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'package'"/></t>
                <span>My orders</span>
            </a>
            <a href="/shop/wishlist" class="o_g2b_acc_tab">
                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'heart'"/></t>
                <span>Wishlist</span>
            </a>
            <a href="/my/account" t-attf-class="o_g2b_acc_tab #{'is-active' if g2b_tab == 'profile' else ''}"
               t-att-aria-current="'page' if g2b_tab == 'profile' else None">
                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'user'"/></t>
                <span>Account details</span>
            </a>
        </nav>
    </template>

    <!--
        One order, as a card: number, date and status; its pictures and
        what it holds; who it goes to; the total, the review button, and
        the way to its tracking page, which the whole card also opens.
    -->
    <template id="order_card" name="Account: order card">
        <t t-set="g2b_sum" t-value="order._g2b_card_summary()"/>
        <t t-set="g2b_state" t-value="order.g2b_tracking_state"/>
        <t t-set="g2b_url" t-value="order._g2b_tracking_url()"/>
        <t t-set="g2b_rs" t-value="order._g2b_review_status()"/>
        <t t-set="g2b_tz" t-value="order._g2b_tz()"/>
        <article t-attf-class="o_g2b_oc o_g2b_oc_#{order._g2b_status_tone()}">
            <a class="o_g2b_oc_link" t-att-href="g2b_url" t-att-aria-label="order.name"/>
            <header class="o_g2b_oc_head">
                <div class="o_g2b_oc_id">
                    <span class="o_g2b_oc_ref" t-out="order.name"/>
                    <span class="o_g2b_oc_date" t-out="order.date_order"
                          t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy', 'tz_name': g2b_tz}"/>
                </div>
                <span class="o_g2b_oc_status" t-out="order._g2b_status_label()"/>
            </header>
            <div class="o_g2b_oc_body">
                <div class="o_g2b_oc_thumbs">
                    <img t-foreach="g2b_sum['images']" t-as="g2b_img" t-att-src="g2b_img" alt=""
                         width="64" height="64" loading="lazy" class="o_g2b_oc_thumb"/>
                    <span t-if="g2b_sum['extra_images']" class="o_g2b_oc_thumb o_g2b_oc_thumb_more"
                          t-out="'+%s' % g2b_sum['extra_images']"/>
                </div>
                <div class="o_g2b_oc_info">
                    <div class="o_g2b_oc_name" t-out="g2b_sum['first']"/>
                    <div t-if="g2b_sum['more']" class="o_g2b_oc_more" t-out="g2b_sum['more']"/>
                    <div class="o_g2b_oc_meta">
                        <t t-if="g2b_state == 'delivered' and order.g2b_delivered_at">
                            <span class="o_g2b_oc_meta_label">Delivered on</span>
                            <span t-out="order.g2b_delivered_at" t-options="{'widget': 'datetime', 'format': 'dd/MM', 'tz_name': g2b_tz}"/>
                        </t>
                        <t t-elif="g2b_state == 'shipping'">
                            <t t-set="g2b_eta" t-value="order._g2b_eta()"/>
                            <t t-if="g2b_eta and g2b_eta['from']">
                                <span class="o_g2b_oc_meta_label">Expected</span>
                                <span t-out="g2b_eta['from']" t-options="{'widget': 'date', 'format': 'EEE dd/MM'}"/>
                                <t t-if="g2b_eta['to'] != g2b_eta['from']">
                                    <span>–</span>
                                    <span t-out="g2b_eta['to']" t-options="{'widget': 'date', 'format': 'EEE dd/MM'}"/>
                                </t>
                            </t>
                        </t>
                        <t t-elif="g2b_state != 'cancelled' and order.partner_shipping_id">
                            <span class="o_g2b_oc_meta_label">To</span>
                            <span t-out="order._g2b_recipient_name()"/>
                        </t>
                    </div>
                </div>
            </div>
            <footer class="o_g2b_oc_foot">
                <div class="o_g2b_oc_total">
                    <span class="o_g2b_oc_total_label">Total</span>
                    <strong t-out="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                </div>
                <div class="o_g2b_oc_actions">
                    <a t-if="g2b_rs and g2b_rs['state'] == 'todo'" class="o_g2b_oc_review"
                       t-att-href="order._g2b_buyer_review_url(g2b_rs['line'])">
                        <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'star'"/></t>
                        <span>Review</span>
                    </a>
                    <a t-elif="g2b_rs" class="o_g2b_oc_reviewed" t-att-href="order._g2b_buyer_review_url()"
                       title="Your review">
                        <t t-call="gif2box_review.stars"><t t-set="g2b_value" t-value="g2b_rs['rating']"/></t>
                    </a>
                    <span class="o_g2b_oc_cta" aria-hidden="true">
                        <span t-if="g2b_state in ('delivered', 'cancelled')">Details</span>
                        <span t-else="">Track</span>
                        <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'chevron'"/></t>
                    </span>
                </div>
            </footer>
        </article>
    </template>

    <!-- No order yet. -->
    <template id="orders_empty" name="Account: no orders">
        <div class="o_g2b_acc_empty">
            <div class="o_g2b_acc_empty_art" aria-hidden="true">
                <t t-call="gif2box_review.gift_art"/>
            </div>
            <div class="o_g2b_acc_empty_title">No orders yet</div>
            <p class="o_g2b_acc_empty_text">When you send a gift, it shows here, and you can follow it all the way to its recipient.</p>
            <a href="/shop" class="o_g2b_acc_btn">Find a gift</a>
        </div>
    </template>

    <!-- =================================================================
         The frame of every account page
         ================================================================= -->

    <!--
        Odoo's breadcrumbs and its side panel give way to the customer's
        name and the account's tabs. Pages a guest opens with a link (a
        quotation, an invoice) get the frame without them.
    -->
    <template id="portal_layout" inherit_id="portal.portal_layout" name="Gif2box account frame" priority="50">
        <xpath expr="//div[hasclass('o_portal')]" position="replace"/>
        <xpath expr="//div[@id='wrap']" position="replace">
            <t t-set="g2b_signed_in" t-value="not request.env.user._is_public()"/>
            <div id="wrap" t-attf-class="o_portal_wrap o_g2b_acc #{'o_g2b_acc_page_%s' % page_name if page_name else ''}">
                <div class="container o_g2b_acc_container">
                    <t t-if="g2b_signed_in" t-call="gif2box_portal.account_header"/>
                    <div class="o_g2b_acc_main">
                        <t t-out="0"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- =================================================================
         My account
         ================================================================= -->

    <template id="account_home" name="My account">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">My account</t>
            <t t-set="no_breadcrumbs" t-value="True"/>

            <section class="o_g2b_acc_stats" aria-label="At a glance">
                <a href="/my/orders" class="o_g2b_acc_stat">
                    <span class="o_g2b_acc_stat_icon"><t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'package'"/></t></span>
                    <span class="o_g2b_acc_stat_n" t-out="g2b_order_count"/>
                    <span class="o_g2b_acc_stat_label">Orders</span>
                </a>
                <a href="/my/orders" class="o_g2b_acc_stat o_g2b_acc_stat_way">
                    <span class="o_g2b_acc_stat_icon"><t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'truck'"/></t></span>
                    <span class="o_g2b_acc_stat_n" t-out="g2b_under_way"/>
                    <span class="o_g2b_acc_stat_label">Under way</span>
                </a>
                <a t-att-href="g2b_to_review[:1]._g2b_buyer_review_url() if g2b_to_review else '/my/orders'"
                   t-attf-class="o_g2b_acc_stat o_g2b_acc_stat_review #{'is-hot' if g2b_to_review else ''}">
                    <span class="o_g2b_acc_stat_icon"><t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'star'"/></t></span>
                    <span class="o_g2b_acc_stat_n" t-out="len(g2b_to_review)"/>
                    <span class="o_g2b_acc_stat_label">To review</span>
                </a>
                <a href="/shop/wishlist" class="o_g2b_acc_stat o_g2b_acc_stat_wish">
                    <span class="o_g2b_acc_stat_icon"><t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'heart'"/></t></span>
                    <span class="o_g2b_acc_stat_n" t-out="g2b_wishlist_count"/>
                    <span class="o_g2b_acc_stat_label">Wishlist</span>
                </a>
            </section>

            <div class="o_g2b_acc_grid">
                <div class="o_g2b_acc_col_main">
                    <a t-if="g2b_to_review" t-att-href="g2b_to_review[:1]._g2b_buyer_review_url()" class="o_g2b_acc_nudge">
                        <span class="o_g2b_acc_nudge_icon" aria-hidden="true">💌</span>
                        <span class="o_g2b_acc_nudge_body">
                            <span class="o_g2b_acc_nudge_title">How did your gift go?</span>
                            <span class="o_g2b_acc_nudge_text">A minute to rate it helps others choose a gift for someone they love.</span>
                        </span>
                        <span class="o_g2b_acc_nudge_cta">Write a review</span>
                    </a>

                    <section class="o_g2b_acc_section">
                        <header class="o_g2b_acc_section_head">
                            <h2 class="o_g2b_acc_h2">Recent orders</h2>
                            <a t-if="g2b_recent_orders" href="/my/orders" class="o_g2b_acc_more">
                                <span>See all</span>
                                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'chevron'"/></t>
                            </a>
                        </header>
                        <div t-if="g2b_recent_orders" class="o_g2b_oc_list">
                            <t t-foreach="g2b_recent_orders" t-as="order">
                                <t t-call="gif2box_portal.order_card"/>
                            </t>
                        </div>
                        <t t-else="" t-call="gif2box_portal.orders_empty"/>
                    </section>
                </div>

                <aside class="o_g2b_acc_col_side">
                    <section class="o_g2b_acc_card">
                        <header class="o_g2b_acc_section_head">
                            <h2 class="o_g2b_acc_h2">Account details</h2>
                            <a href="/my/account" class="o_g2b_acc_more">
                                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'pencil'"/></t>
                                <span>Edit</span>
                            </a>
                        </header>
                        <ul class="o_g2b_acc_facts">
                            <li>
                                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'user'"/></t>
                                <span t-out="g2b_partner.name"/>
                            </li>
                            <li t-if="g2b_partner.email">
                                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'mail'"/></t>
                                <span t-out="g2b_partner.email"/>
                            </li>
                            <li t-if="g2b_partner.phone or g2b_partner.mobile">
                                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'phone'"/></t>
                                <span t-out="g2b_partner.phone or g2b_partner.mobile"/>
                            </li>
                            <li t-if="g2b_partner.street or g2b_partner.state_id">
                                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'pin'"/></t>
                                <span t-out="g2b_partner" t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True, 'separator': ', '}"/>
                            </li>
                        </ul>
                        <a href="/my/security" class="o_g2b_acc_link_row">
                            <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'lock'"/></t>
                            <span>Change my password</span>
                            <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'chevron'"/></t>
                        </a>
                    </section>

                    <section class="o_g2b_acc_card o_g2b_acc_help">
                        <h2 class="o_g2b_acc_h2">Need help?</h2>
                        <p class="o_g2b_acc_muted">We are here from 8:00 to 17:00, Monday to Friday.</p>
                        <a t-if="g2b_support_phone" t-attf-href="tel:#{g2b_support_phone.replace(' ', '')}" class="o_g2b_acc_link_row">
                            <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'phone'"/></t>
                            <span t-out="g2b_support_phone"/>
                            <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'chevron'"/></t>
                        </a>
                        <a href="/order/track" class="o_g2b_acc_link_row">
                            <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'search'"/></t>
                            <span>Track an order</span>
                            <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'chevron'"/></t>
                        </a>
                        <a href="/contactus" class="o_g2b_acc_link_row">
                            <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'mail'"/></t>
                            <span>Contact us</span>
                            <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'chevron'"/></t>
                        </a>
                    </section>
                </aside>
            </div>
        </t>
    </template>

    <!-- =================================================================
         My orders
         ================================================================= -->

    <template id="account_orders" name="My orders">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">My orders</t>
            <t t-set="no_breadcrumbs" t-value="True"/>

            <header class="o_g2b_acc_page_head">
                <h1 class="o_g2b_acc_h1">My orders</h1>
                <a href="/shop" class="o_g2b_acc_btn o_g2b_acc_btn_ghost o_g2b_acc_btn_sm">
                    <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'bag'"/></t>
                    <span>Keep shopping</span>
                </a>
            </header>

            <t t-if="g2b_any_order">
                <nav class="o_g2b_acc_filters" aria-label="Filter orders">
                    <a t-foreach="g2b_tabs" t-as="g2b_t"
                       t-att-href="'/my/orders' if g2b_t['key'] == 'all' else '/my/orders?status=%s' % g2b_t['key']"
                       t-attf-class="o_g2b_acc_chip #{'is-active' if g2b_t['active'] else ''}"
                       t-att-aria-current="'page' if g2b_t['active'] else None">
                        <span t-out="g2b_t['label']"/>
                        <span class="o_g2b_acc_chip_n" t-out="g2b_t['count']"/>
                    </a>
                </nav>

                <div t-if="orders" class="o_g2b_oc_list">
                    <t t-foreach="orders" t-as="order">
                        <t t-call="gif2box_portal.order_card"/>
                    </t>
                </div>
                <div t-else="" class="o_g2b_acc_empty o_g2b_acc_empty_sm">
                    <div class="o_g2b_acc_empty_title">No orders here</div>
                    <a href="/my/orders" class="o_g2b_acc_more">See all my orders</a>
                </div>

                <div t-if="pager and pager['page_count'] &gt; 1" class="o_g2b_acc_pager">
                    <t t-call="portal.pager"/>
                </div>
            </t>
            <t t-else="" t-call="gif2box_portal.orders_empty"/>
        </t>
    </template>

    <!-- =================================================================
         Account details (/my/account)
         ================================================================= -->

    <template id="portal_my_details" inherit_id="portal.portal_my_details" name="Gif2box account details">
        <xpath expr="//form" position="before">
            <header class="o_g2b_acc_page_head">
                <div>
                    <h1 class="o_g2b_acc_h1">Account details</h1>
                    <p class="o_g2b_acc_muted mb-0">Your name, how to reach you, and the address your orders start from.</p>
                </div>
            </header>
        </xpath>
        <xpath expr="//div[hasclass('o_portal_details')]" position="attributes">
            <attribute name="class" add="o_g2b_acc_card o_g2b_acc_form" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_portal_details')]/div[hasclass('col-lg-8')]" position="attributes">
            <attribute name="class">col-12</attribute>
        </xpath>
        <xpath expr="//a[@href='/my/']" position="attributes">
            <attribute name="href">/my/home</attribute>
            <attribute name="class">o_g2b_acc_btn o_g2b_acc_btn_ghost</attribute>
        </xpath>
        <xpath expr="//button[@type='submit']" position="attributes">
            <attribute name="class">o_g2b_acc_btn</attribute>
        </xpath>
        <xpath expr="//form" position="after">
            <a href="/my/security" class="o_g2b_acc_card o_g2b_acc_link_card">
                <span class="o_g2b_acc_link_card_icon">
                    <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'lock'"/></t>
                </span>
                <span class="o_g2b_acc_link_card_body">
                    <span class="o_g2b_acc_link_card_title">Password</span>
                    <span class="o_g2b_acc_muted">Change the password you sign in with.</span>
                </span>
                <t t-call="gif2box_portal.icon"><t t-set="g2b_icon" t-value="'chevron'"/></t>
            </a>
        </xpath>
    </template>

    <!-- =================================================================
         The tracking page, for the order's own customer
         ================================================================= -->

    <!-- Signed in and the order is theirs: back to their orders, not to the lookup. -->
    <template id="tracking_breadcrumb" inherit_id="gif2box_order_tracking.order_track_page" name="Tracking: back to my orders">
        <xpath expr="//nav[hasclass('o_g2b_track_crumbs')]//li[a[@href='/order/track']]" position="replace">
            <t t-set="g2b_mine" t-value="not request.env.user._is_public() and order.partner_id.commercial_partner_id == request.env.user.partner_id.commercial_partner_id"/>
            <li t-if="g2b_mine" class="breadcrumb-item"><a href="/my/orders">My orders</a></li>
            <li t-else="" class="breadcrumb-item"><a href="/order/track">Track your order</a></li>
        </xpath>
    </template>

</odoo>
